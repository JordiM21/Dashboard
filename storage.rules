rules_version = '2';

// Owner-only, same UID as firestore.rules. Social uploads go straight from the
// browser (components/hub/screens/Social.tsx); app/api/resources/** uses
// firebase-admin, which bypasses these rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == "Nabyq1LVHfRG8c7acQzyZZerJSB3";
    }
  }
}
