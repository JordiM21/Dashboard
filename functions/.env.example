# Copy to functions/.env for local emulation. For a real deploy, prefer
# `firebase functions:secrets:set NAME` (Secret Manager) over plain env vars
# for these — they're all webhook-authenticity secrets.

# Meta (Facebook) Lead Ads webhook — Meta Developer Console > your App >
# Webhooks. META_WEBHOOK_VERIFY_TOKEN is one you invent yourself (used only
# during the one-time verification handshake); META_APP_SECRET comes from
# App Settings > Basic; META_PAGE_ACCESS_TOKEN comes from the Page you're
# receiving leads for (needed only if you want field data auto-fetched from
# Meta's Graph API instead of testing with a flat payload).
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# Stripe payment webhook — Stripe Dashboard > Developers > API keys for the
# secret key, and Developers > Webhooks > your endpoint > Signing secret
# for the webhook secret (only available *after* you've created the
# endpoint with your deployed function URL — see README.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
