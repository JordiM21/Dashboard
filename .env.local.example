# Copy this file to .env.local and fill in the values you have.
# Any integration left blank falls back to dummy data automatically.

# Stripe — see lib/api/stripe.ts for setup steps
STRIPE_SECRET_KEY=

# Kommo CRM — see lib/api/kommo.ts for setup steps
KOMMO_SUBDOMAIN=
KOMMO_ACCESS_TOKEN=

# Vercel Cron secret — protects app/api/cron/recurring-payments from being
# triggered by anyone who finds the URL. Only needed once deployed to
# Vercel (set the same value in Vercel > Project > Environment Variables);
# not required for local dev, where the "Run now" button uses your signed-in
# session instead. Any random string works — e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Meta Ads — see lib/api/meta.ts for setup steps
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
# Meta Page/Instagram content — see lib/api/metaContent.ts for setup steps
# (both optional — auto-detected from META_ACCESS_TOKEN's /me/accounts if unset)
META_PAGE_ID=
META_IG_BUSINESS_ACCOUNT_ID=

# Firebase — client SDK config (Project settings > General > Your apps > SDK
# setup and configuration). Not secret — safe to ship in the client bundle;
# access control lives in firestore.rules instead. See lib/firebase/client.ts.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — server-only service account for Next.js Route Handlers.
# Project settings > Service accounts > Generate new private key downloads a
# JSON file. Never commit that file or its contents, or share it in
# chat/screenshots — it grants full read/write to Firestore. See
# lib/firebase/admin.ts.
#
# Option A (recommended) — point at the downloaded file directly:
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
# Option B — paste the file's JSON as ONE line (easy to get wrong: the
# private_key field's embedded newlines must stay as literal \n escapes,
# not real line breaks — Option A avoids this entirely):
FIREBASE_SERVICE_ACCOUNT_KEY=
