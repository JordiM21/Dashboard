rules_version = '2';

// Firebase Authentication is now enforced (Email/Password, single admin
// user, provisioned manually in the Firebase console — no self-serve
// sign-up exists anywhere in this app).
//
// This only protects direct Firestore access from the client SDK
// (onSnapshot in lib/firebase/useFirestoreCollection.ts). It does NOT cover
// app/api/students/route.ts or app/api/finance/route.ts — those use
// firebase-admin, which bypasses these rules entirely by design. Their
// protection is requireAuth() in lib/firebase/verifyAuth.ts, which verifies
// the same Firebase ID token via firebase-admin/auth. Both layers must stay
// in sync: this file is the boundary for reads/writes coming straight from
// a browser; verifyAuth.ts is the boundary for anything going through our
// own server.
//
// TODO(before any public-facing deployment): this only requires *a*
// signed-in user, not a specific admin — fine for a single-operator tool,
// not fine once/if multiple accounts could exist. Add role-based checks
// (e.g. a custom claim) or IP allowlisting at the hosting layer if that
// changes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
