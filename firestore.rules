rules_version = '2';

// Owner-only. The client config is public, so "any signed-in user" would let
// anyone who creates a Firebase account read everything — pin to one UID.
// Keep the UID in sync with storage.rules and lib/firebase/verifyAuth.ts.
//
// firebase-admin (app/api/**, functions/) bypasses these rules; its boundary
// is requireAuth() in lib/firebase/verifyAuth.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == "Nabyq1LVHfRG8c7acQzyZZerJSB3";
    }
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
